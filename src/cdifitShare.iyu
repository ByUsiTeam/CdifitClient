{
	us(5,"visibility","gone")
}</eventItme><eventItme type="ondownloadstart">hws(st_url)</eventItme><eventItme type="onpagefinished">syso("URL加载完成，被加载URL："+st_url)</eventItme><eventItme type="onpagestarted">syso("开始加载 → "+st_url)</eventItme><eventItme type="onreceivederror">syso("加载失败 → "+st_url)</eventItme></event>
