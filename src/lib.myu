otob("file",null,sele,a)
java(n,null,"android.util.Base64.encode","byte[]",a,"int",0)
btoo(n,"$diy/zit")
fr("$diy/zit",o)
sr(o,"\n","",o)
fw("$diy/zit",o)
sss zit=o


ug(id,"url",a)
us(id,"url",a)

end fn