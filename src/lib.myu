fn wp(id)

fe("$System/Settings/backgrounds.sett",sett_sfcz)
syso("壁纸存在状态："+sett_sfcz)
fw("$temp/i.tzt","壁纸存在状态："+sett_sfcz)
f(sett_sfcz == true)
{
	us(id,"visibility","visible")
	us(id,"src","$System/Settings/backgrounds.sett")
}
else
{
	us(id,"visibility","gone")
}

end fn

fn keepAlive()

/.
s sc =1
t()
{
	s(sc * "60",sj)
	s(sj * "1000",schang)
	stop(schang)
	f(sss.sbhzt != true)
	{
		time(0,time)
		ss("[ "+time+" ] 保活状态 → 保活中\n计时时长 → "+schang,bhztlog)
		syso(bhztlog)
		fn core.logs(bhztlog)
		fn lib.keepAlive()
	}
	else
	{
		time(0,time)
		ss("[ "+time+" ] 保活状态 → 停止保活",bhztlog)
		fn core.logs(bhztlog)
		sss sbhzt =null
	}
}
./
syso("并没有确定保活功能开发完成")

end fn

